    _sky_passthrough(["cancel", "-y"], job_id)


@cli.command()
@click.argument("globs", nargs=-1)
@_vpn_hint
def status(globs):
    """Show done and managed-job state for jobs whose tags match the GLOBS."""
    sky_cfg = _sky_config()
    if not os.environ.get("R3_REPOSITORY"):
        raise click.ClickException("R3_REPOSITORY is not set")
    store = _store(sky_cfg)
    reachable = True
    try:
        _ping(store, sky_cfg)
    except s3.StoreUnreachable:
        reachable = False
        print("(S3 unreachable — done column from local markers only)")
    user = _sky_user()
    repository = r3.Repository(os.environ["R3_REPOSITORY"])
    query = {"$and": [{"tags": {"$glob": g}} for g in globs]} if globs else {}
    jobs = repository.find(query=query)
    if not jobs:
        print("No jobs found.")
        return
    managed = None
    try:
        managed = _managed_jobs(skip_finished=False)
    except click.ClickException as e:
        print(f"(SkyPilot state unavailable: {e.message})")
    newest: dict = {}
    for j in managed or []:
        cur = newest.get(j.get("job_name"))
        if cur is None or _sort_key(j) >= _sort_key(cur):
            newest[j.get("job_name")] = j
    layout = lib.S3Layout(str(sky_cfg["prefix"]).rstrip("/"))
    rows = [("r3 id", "tag", "done", "managed", "managed id")]
    for job in sorted(jobs, key=lambda j: (j.metadata.get("tags") or [""])[0]):
        local = Path(job.path) / "output" / "done"
        remote_text = None
        if reachable:
            try:
                remote_text = store.read_text(layout.done(job.id))
            except Exception:
                reachable = False
                print("(S3 unreachable — done column from local markers only)")
        done = lib.effective_done(remote_text,
                                  local.read_text() if local.is_file() else None)
        if managed is None:
            mstate, mid = "?", "?"
        else:
            m = newest.get(lib.managed_job_name(user, job.id))
            mstate, mid = (m.get("status"), str(m.get("job_id"))) if m else ("", "")
        rows.append((job.id, (job.metadata.get("tags") or [""])[0], done or "-",
                     mstate, mid))
    widths = [max(len(str(r[i])) for r in rows) for i in range(5)]
    for r in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())


